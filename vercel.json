{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai-dev-assistant-backend": {
      "root": "ai-dev-assistant-backend",
      "framework": "express",
      "entrypoint": "src/app.js"
    },
    "ai-dev-assistant-frontend": {
      "root": "ai-dev-assistant-frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "ai-dev-assistant-backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "ai-dev-assistant-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "ai-dev-assistant-frontend"
      }
    }
  ]
}

